.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# local state and secrets - never commit
.env
.env.*
!.env.example
data/
*.db
*.sqlite3
.supabase/
supabase/.temp/
supabase/.branches/

# local tooling
.claude/

# vercel (the CLI writes a short-lived OIDC token to .env.local; .env.* above already covers it)
.vercel/

# local Qdrant test server marker
.qdrant-initialized

# frontend tooling (the built UI in src/ragintegrity/api/static IS committed, so deploys need no Node build)
frontend/node_modules/
frontend/*.tsbuildinfo
frontend/.vite/
