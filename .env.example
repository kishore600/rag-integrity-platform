# Copy to .env (git-ignored) and fill in. Every variable is optional in demo mode.
# Secrets live ONLY in the environment; they are never written to the ledger database.

# ---- multi-user app (RAGI_MODE=app): what the hosted product uses ------------------------------------
# Users sign up and connect THEIR OWN S3 / manifest / Qdrant in the Settings page; nothing is configured here for them.
# Needs a Postgres/Supabase RAGI_DATABASE_URL (below) and:
RAGI_SECRET_KEY=                     # 32+ random characters; encrypts users' stored connection secrets. Keep a copy.
RAGI_ALLOW_REGISTRATION=true         # false closes sign-up (there is no email verification)
RAGI_ALLOW_PRIVATE_HOSTS=false       # true lets users point connectors at private/loopback hosts: self-hosting only
RAGI_SESSION_DAYS=7
RAGI_MAX_AUDIT_SECONDS=0             # 0 = no limit (270 s is implied on serverless)

# ---- general -----------------------------------------------------------------------------------
RAGI_MODE=demo                       # demo = built-in synthetic world | live = one S3+Postgres+Qdrant set from this file | app = multi-user
RAGI_API_KEY=                        # if set, every /api/* call needs it (X-API-Key or Authorization: Bearer)
RAGI_AUDIT_INTERVAL_MINUTES=0        # >0 enables the built-in scheduler; or run `ragi audit` from cron / CI
RAGI_GRACE_MINUTES=10                # do not flag documents that are probably still being ingested
RAGI_SOURCE_DOCUMENTS_ONLY=false     # true: audit only documents found in S3 (the key pattern picks them); ignore other manifest rows / vectors
RAGI_AUDIT_SLICE_DOCUMENTS=5000         # with the line above on: documents per slice of the index; each finished slice is a checkpoint (an interrupted audit can resume)

# ---- ledger: where issues, audit history and repair plans live ------------------------------------
# Default is a local SQLite file. For production use a Postgres / Supabase connection string.
# Supabase: Project Settings -> Database -> Connection string. Prefer the *Session pooler* (port 5432) or the
# direct connection; append ?sslmode=require. The transaction pooler (6543) also works.
RAGI_DATABASE_URL=sqlite:///./data/ragi.db
# RAGI_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---- live mode: source documents in S3 --------------------------------------------------------------
# AWS credentials come from the standard chain (AWS_ACCESS_KEY_ID / AWS_PROFILE / instance role). Read-only IAM is enough:
# s3:ListBucket on the bucket and s3:GetObject on its objects (AWS requires GetObject for HEAD, which reads the content hash;
# only RAGI_S3_HASH_MODE=etag audits can run with ListBucket alone). Nothing is ever written.
RAGI_S3_BUCKET=
RAGI_S3_PREFIX=
RAGI_S3_REGION=
RAGI_S3_ENDPOINT_URL=                # MinIO / LocalStack
RAGI_S3_HASH_MODE=metadata           # metadata | compute | etag   (see docs/configuration.md; ETags are NOT content hashes)
RAGI_S3_SHA256_METADATA_KEY=sha256
RAGI_S3_KEY_PATTERN=^(?P<tenant_id>[^/]+)/(?P<document_id>.+)$
RAGI_S3_LOOKUP_FROM_MANIFEST=false   # true: HEAD the files the manifest's source_uri names instead of listing a huge bucket

# ---- live mode: the processing manifest (PostgreSQL / Supabase), read-only ---------------------------------
RAGI_MANIFEST_DATABASE_URL=          # use a role that can only SELECT (see supabase/examples/manifest_example.sql)
RAGI_MANIFEST_SCHEMA=public
RAGI_MANIFEST_TABLE=rag_document_manifest
RAGI_MANIFEST_CHUNK_TABLE=           # optional chunk-level manifest: lets us name the *missing chunks*
RAGI_MANIFEST_COLUMN_MAP=            # JSON, e.g. {"document_id": "doc_ref", "processing_status": "state"}

# ---- live mode: the vector index (Qdrant), read-only ---------------------------------------------------------
RAGI_QDRANT_URL=
RAGI_QDRANT_API_KEY=
RAGI_QDRANT_COLLECTIONS=kb_main      # comma separated; a document is expected in at least one of them
RAGI_QDRANT_PAYLOAD_MAP=             # JSON, e.g. {"document_id": "doc_id", "tenant_id": "meta.tenant"}
RAGI_QDRANT_CHECK_VECTORS=false      # true also pulls vectors to find empty / all-zero embeddings (slower)

# ---- the pipeline fingerprint the index SHOULD be built with ------------------------------------------------------
# Leave unset to only detect mixed configurations inside one document.
RAGI_TARGET_PARSER_VERSION=
RAGI_TARGET_CHUNKING_VERSION=
RAGI_TARGET_CHUNK_SIZE=
RAGI_TARGET_CHUNK_OVERLAP=
RAGI_TARGET_EMBEDDING_MODEL=
RAGI_TARGET_EMBEDDING_MODEL_VERSION=
RAGI_TARGET_EMBEDDING_DIM=
RAGI_TARGET_PREPROCESSING=

# ---- repair + alerts --------------------------------------------------------------------------------------------------
RAGI_REPAIR_WEBHOOK_URL=             # your ingestion worker (see docs/repair-webhook.md)
RAGI_REPAIR_WEBHOOK_SECRET=          # shared HMAC key; required for any real webhook URL
RAGI_PUBLIC_BASE_URL=                # where the worker can reach this app, for completion callbacks
RAGI_CLEANUP_POLICY=manual           # manual = an operator approves vector removal | auto = after verification
RAGI_ALERT_WEBHOOK_URL=              # Slack-compatible incoming webhook
RAGI_ALERT_MIN_SEVERITY=high
RAGI_ALERT_EMAIL_WHEN=always         # after every audit an email is sent: always | attention (only when it matters) | never. The in-app notification is always created.
RAGI_ALERT_EMAIL_TO=                 # single-user modes: who gets the email (comma-separated). App mode emails each workspace's own users.
RAGI_APP_URL=                        # the public address of this deployment: the links in emails point here
RAGI_SMTP_HOST=                      # the mail account that sends the emails (leave empty for no email)
RAGI_SMTP_PORT=587
RAGI_SMTP_USER=
RAGI_SMTP_PASSWORD=
RAGI_SMTP_FROM=                      # for example: RAGGuard <alerts@yourdomain.com>
RAGI_SMTP_SECURITY=starttls          # starttls | ssl | none
RAGI_EMBEDDING_PRICE_PER_MTOK=0.13   # USD per 1M tokens, for workload estimates
